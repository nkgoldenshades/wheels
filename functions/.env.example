# ═══════════════════════════════════════════════════════════════════════════
# RAZORPAY ESCROW PAYMENT GATEWAY
# ═══════════════════════════════════════════════════════════════════════════

# PAYMENT MODE SWITCH
# Set to true for LIVE/production, false for TEST/development
USE_LIVE_KEYS=false

# Supabase Configuration
SUPABASE_URL=https://uklltpopjovbhplbvltr.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ═══════════════════════════════════════════════════════════════════════════
# 🧪 TEST MODE - RAZORPAY TEST KEYS (for local development only)
# ═══════════════════════════════════════════════════════════════════════════
# Get these from: https://dashboard.razorpay.com/app/keys

RAZORPAY_KEY_ID_TEST=rzp_test_YOUR_TEST_KEY_ID
RAZORPAY_KEY_SECRET_TEST=your_test_secret_here

# ═══════════════════════════════════════════════════════════════════════════
# 🚀 LIVE/PRODUCTION - RAZORPAY LIVE KEYS
# ═══════════════════════════════════════════════════════════════════════════
# ⚠️ IMPORTANT: DO NOT add live keys to this .env file!
# 
# Live keys should ONLY be stored in Firebase Secret Manager for security.
# 
# To set live keys in Secret Manager:
#   firebase functions:secrets:set RAZORPAY_KEY_ID_LIVE
#   firebase functions:secrets:set RAZORPAY_KEY_SECRET_LIVE
#
# To view existing secrets:
#   firebase functions:secrets:access RAZORPAY_KEY_ID_LIVE
#   firebase functions:secrets:access RAZORPAY_KEY_SECRET_LIVE
#
# Why this approach?
# ✅ Live keys never touch version control
# ✅ Live keys are encrypted in Google Cloud
# ✅ Only deployed functions can access them
# ✅ Automatic rotation and access control
# ✅ Audit logs for who accessed secrets
# 
# Your deployed functions will automatically use Secret Manager values
# when USE_LIVE_KEYS=true, regardless of what's in this .env file.
# ═══════════════════════════════════════════════════════════════════════════
