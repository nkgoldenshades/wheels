#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secrets & environment files — never commit these
.env
.env.*
!.env.example
functions/.env
functions/.env.*
!functions/.env.example

# Firebase service account keys
*service-account*.json
*serviceAccount*.json
firebase-adminsdk*.json

# 🔒 SECURITY: Firebase & Google Services Configuration
# These files contain API keys and should NEVER be committed
firebase_options.dart
lib/firebase_options.dart
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# 🔒 SECURITY: Supabase Configuration
# Contains database URLs and API keys
lib/config/supabase_config.dart

# 🔒 SECURITY: Backend Functions (contains payment logic & API keys)
functions/
firebase_functions/

# 🔒 SECURITY: Supabase backend
supabase/
