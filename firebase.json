{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-functions-debug.log"
      ],
      "secretEnvironmentVariables": [
        {
          "key": "USE_LIVE_KEYS",
          "projectId": "quickohunt-app"
        },
        {
          "key": "RAZORPAY_KEY_ID_LIVE",
          "projectId": "quickohunt-app"
        },
        {
          "key": "RAZORPAY_KEY_SECRET_LIVE",
          "projectId": "quickohunt-app"
        },
        {
          "key": "RAZORPAY_KEY_ID_TEST",
          "projectId": "quickohunt-app"
        },
        {
          "key": "RAZORPAY_KEY_SECRET_TEST",
          "projectId": "quickohunt-app"
        }
      ]
    }
  ],
  "hosting": [
    {
      "target": "quickohunt-app",
      "public": "build/web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000"
            }
          ]
        },
        {
          "source": "**/*.@(png|jpg|jpeg|gif|svg|webp|ico)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000"
            }
          ]
        }
      ]
    },
    {
      "target": "vaultwheels",
      "public": "build/web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000"
            }
          ]
        },
        {
          "source": "**/*.@(png|jpg|jpeg|gif|svg|webp|ico)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000"
            }
          ]
        }
      ]
    }
  ]
}
